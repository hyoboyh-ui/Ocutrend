# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Web検索カテゴリ専用。検索結果が入力トークンとして繰り返し課金されるためコストが集中する箇所。
# Haiku 4.5 は $1/$5 per MTok（Sonnet 5 の導入価格の半額）。品質が落ちる場合は
# claude-sonnet-5 に戻す（コード変更は不要。ただしVercelは環境変数をデプロイ時に注入するので、
# 値を変えたあと再デプロイしないと反映されない）。
ANTHROPIC_WEB_SEARCH_MODEL=claude-haiku-4-5

# YouTube Data API v3
YOUTUBE_API_KEY=

# App password gate
APP_PASSWORD=
SESSION_SECRET=

# Vercel Cron
CRON_SECRET=

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hyoboyh@gmail.com

# Voyage AI (段階2: お気に入りベースのembeddingリランキング。任意 — 未設定でも他機能に影響しない)
# https://www.voyageai.com/ でアカウント作成しAPIキーを発行する
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
